---
import '@fontsource-variable/manrope';
import '../styles/landing.css';
import AccountTools from '../components/AccountTools.astro';
import { plans, subjectCountLabel } from '../scripts/plans.js';
const faqs = [
  [
    'Можно ли посмотреть программу без регистрации?',
    'Да. Можно выбрать класс, посмотреть предметы и темы. Для просмотра видео и выполнения заданий нужно зарегистрироваться и оплатить тариф.',
  ],
  [
    'Кто проверяет задания?',
    'Тесты проверяются автоматически. Развёрнутые ответы проверяет преподаватель, закреплённый за учеником по этому предмету. В обсуждении задания можно задать ему вопрос.',
  ],
  [
    'Откроются ли материалы других классов?',
    'Нет. Тариф даёт доступ к выбранным предметам только в выбранном классе.',
  ],
  [
    'Что произойдёт после окончания тарифа?',
    'Доступ к видео и заданиям закроется. Аккаунт, отметки и прогресс сохранятся. После продления можно будет продолжить обучение.',
  ],
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="robots" content="noindex,nofollow" /><meta
      name="theme-color"
      content="#f7f9f7"
    />
    <title>Юнискул — видеоуроки для 1–11 классов</title>
    <meta
      name="description"
      content="Понятные видеоуроки и задания с поддержкой преподавателя. Юнискул — проект Онлайн-гимназии для 1–11 классов."
    />
  </head>
  <body>
    <svg
      class="svg-library"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <symbol id="l-arrow" viewBox="0 0 24 24"
        ><path d="M4 12h15m-6-6 6 6-6 6"></path></symbol
      >
      <symbol id="l-check" viewBox="0 0 24 24"
        ><path d="m5 12 4 4L19 6"></path></symbol
      >
      <symbol id="l-play" viewBox="0 0 24 24"
        ><path d="m9 5 11 7-11 7Z"></path></symbol
      >
      <symbol id="l-lock" viewBox="0 0 24 24"
        ><rect x="5" y="10" width="14" height="11" rx="3"></rect><path
          d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"></path></symbol
      >
      <symbol id="l-book" viewBox="0 0 24 24"
        ><path
          d="M12 5v15M12 5C8 2 4 3 2 4v15c4-2 7-1 10 1 3-2 6-3 10-1V4c-3-1-6-2-10 1Z"
        ></path></symbol
      >
      <symbol id="l-close" viewBox="0 0 24 24"
        ><path d="m6 6 12 12M18 6 6 18"></path></symbol
      >
      <symbol id="l-chat" viewBox="0 0 24 24"
        ><path d="M21 11a9 9 0 0 1-9 9H4l-2 2V11a9.5 9.5 0 1 1 19 0Z"
        ></path><path d="M7 10h9M7 14h5"></path></symbol
      >
      <symbol id="l-clock" viewBox="0 0 24 24"
        ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"
        ></path></symbol
      >
    </svg>
    <header class="site-header">
      <a
        class="brand"
        href={import.meta.env.BASE_URL}
        aria-label="Юнискул — главная"
        ><span class="brand-mark">ю<span>•</span></span><span
          >юнискул<small>ПРОЕКТ ОНЛАЙН-ГИМНАЗИИ</small></span
        ></a
      >
      <nav class="desktop-nav" aria-label="Основная навигация">
        <a href="#subjects">Предметы</a><a href="#plans">Тарифы</a><a
          href="#how">Как учиться</a
        >
      </nav>
      <div class="header-actions">
        <AccountTools />
        <button class="login-button" data-auth="login"
          >Войти <svg><use href="#l-arrow"></use></svg></button
        ><button
          class="menu-button"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Открыть меню"><span></span><span></span></button
        >
      </div>
      <nav
        id="mobile-menu"
        class="mobile-menu"
        aria-label="Мобильная навигация"
        hidden
      >
        <a href="#subjects">Предметы</a><a href="#plans">Тарифы</a><a
          href="#how">Как учиться</a
        >
      </nav>
    </header>
    <main>
      <section class="hero page-width" aria-labelledby="hero-title">
        <div class="hero-copy">
          <span class="eyebrow"><i></i> ОНЛАЙН-ОБУЧЕНИЕ · 1–11 КЛАССЫ</span><h1
            id="hero-title"
          >
            Твоя школа.<br />В твоём <em>ритме.</em>
          </h1><p>
            Понятные видеоуроки, практика и поддержка учителя. Выбирай предметы
            и учись тогда, когда тебе удобно.
          </p><div class="hero-actions">
            <a class="button blue" href="#subjects"
              >Найти свой предмет <svg><use href="#l-arrow"></use></svg></a
            ><a class="subtle-link" href="#plans">Выбрать тариф ↗</a>
          </div><div class="hero-footnote">
            <span class="mini-symbol">✳</span><span
              >Школьная программа.<br /><strong
                >Больше понимания и уверенности.</strong
              ></span
            >
          </div>
        </div>
        <div
          class="hero-art"
          aria-label="Иллюстрация урока математики и обратной связи преподавателя"
          role="img"
        >
          <span class="art-orbit orbit-one"></span><span
            class="art-orbit orbit-two"></span><span class="floating-star"
            >✳</span
          ><div class="lesson-preview">
            <div class="preview-top">
              <span><i></i> УРОК МАТЕМАТИКИ</span><span>7 класс</span>
            </div><h2>Сложное становится<br /><em>понятным.</em></h2><div
              class="math-equation"
            >
              2<span>x</span> + 3 = 11
            </div><div class="preview-bottom">
              <span class="preview-play"
                ><svg><use href="#l-play"></use></svg></span
              ><span class="preview-track"><i></i></span><span>12:30</span>
            </div>
          </div><div class="answer-sticker">
            А если x = 4?<span>Всё сходится! ✓</span>
          </div><div class="teacher-sticker">
            <span class="teacher-avatar">ЕА</span><div>
              <strong>Елена Андреевна</strong><p>
                Отлично! Ты всё поняла <span>✦</span>
              </p>
            </div><span class="grade">5</span>
          </div><span class="hand-note"
            >Маленькие шаги —<br />большие открытия.</span
          >
        </div>
      </section>
      <div class="benefits page-width">
        {
          [
            ['play', 'Уроки в записи', 'Смотри и возвращайся к сложному'],
            ['book', 'Практика после урока', 'Закрепляй то, что узнал'],
            ['chat', 'Преподаватель рядом', 'Задавай вопросы по заданию'],
          ].map(([icon, title, text]) => (
            <div>
              <>
                <svg>
                  <use href={`#l-${icon}`} />
                </svg>
                <span>
                  <>
                    <strong>{title}</strong>
                    <small>{text}</small>
                  </>
                </span>
              </>
            </div>
          ))
        }
      </div>
      <section
        class="plans-section page-width"
        id="plans"
        aria-labelledby="plans-title"
      >
        <div class="section-heading">
          <div>
            <span class="eyebrow">СТОЛЬКО, СКОЛЬКО НУЖНО ТЕБЕ</span><h2
              id="plans-title"
            >
              Выбери свой Юнискул
            </h2>
          </div><div class="period-control">
            <label for="plan-period">Срок доступа</label><select
              id="plan-period"><option value="1">1 месяц</option></select
            >
          </div>
        </div>
        <div class="plans-grid">
          {
            plans.map((plan) => (
              <article
                class:list={[
                  'plan-card',
                  {
                    'plan-featured': plan.id === 6,
                    'plan-live': plan.id === 7,
                  },
                ]}
              >
                <div class="plan-intro">
                  <>
                    <span class="plan-symbol">
                      {plan.id < 5 ? plan.subjects : '+'}
                    </span>
                    <div>
                      <>
                        <h3>{plan.name}</h3>
                        <p>{plan.description}</p>
                      </>
                    </div>
                  </>
                </div>
                <div class="plan-price">
                  <>
                    <strong data-price={plan.id}>
                      {new Intl.NumberFormat('ru-RU').format(plan.monthly)} ₽
                    </strong>
                    <span data-period-label>за 1 месяц</span>
                  </>
                </div>
                <ul>
                  {[
                    subjectCountLabel(plan.subjects) + ' в своём классе',
                    ...plan.features,
                  ].map((text) => (
                    <li>
                      <svg>
                        <use href="#l-check" />
                      </svg>
                      {text}
                    </li>
                  ))}
                </ul>
                <div class="included-guide">
                  <svg>
                    <use href="#l-book" />
                  </svg>
                  «Как учиться в Юнискул» включено
                </div>
                {plan.perLesson && (
                  <p class="plan-detail-note">
                    Разовое онлайн-занятие — 1 399 ₽. В месячный пакет входят
                    все занятия по расписанию по выбранному предмету.
                  </p>
                )}
                <button class="button orange" data-plan={plan.id}>
                  Выбрать тариф{' '}
                  <svg>
                    <use href="#l-arrow" />
                  </svg>
                </button>
              </article>
            ))
          }
        </div>
        <p class="pricing-note">
          Стоимость указана за месяц доступа. Сейчас работает демонстрация
          выбора тарифа: деньги не списываются.
        </p><div class="plan-bottom">
          <span
            ><svg><use href="#l-lock"></use></svg>Перед оплатой — обязательная
            регистрация</span
          ><span
            ><svg><use href="#l-clock"></use></svg>Доступ открывается после
            подтверждения оплаты</span
          >
        </div>
      </section>
      <section
        class="catalog-section page-width"
        id="subjects"
        aria-labelledby="catalog-title"
      >
        <div class="section-heading">
          <div>
            <span class="eyebrow">ОТ ЛЮБОПЫТСТВА — К ЗНАНИЯМ</span><h2
              id="catalog-title"
            >
              Что будем изучать?
            </h2>
          </div><p class="section-caption">
            Выбери класс и загляни<br />в программу предмета.
          </p>
        </div><div class="grade-filter">
          <span>Твой класс</span><div role="group" aria-label="Выбор класса">
            {
              Array.from({ length: 11 }, (_, i) => (
                <button data-grade={i + 1} aria-pressed={i === 6}>
                  {i + 1}
                </button>
              ))
            }
          </div>
        </div><div id="subject-grid" class="subject-grid" aria-live="polite">
        </div><p class="catalog-note">
          <svg><use href="#l-lock"></use></svg>Программа открыта для знакомства.
          Видео и задания доступны после оплаты выбранного предмета.
        </p>
      </section>
      <section class="how-section" id="how">
        <div class="page-width">
          <div class="section-heading">
            <div>
              <span class="eyebrow">ПОНЯТНО С ПЕРВОГО ШАГА</span><h2>
                Учиться проще, чем кажется
              </h2>
            </div><span class="how-flower" aria-hidden="true">✳</span>
          </div><div class="steps-grid">
            {
              [
                [
                  '01',
                  'Выбери своё',
                  'Класс, от одного до четырёх предметов и подходящий формат обучения.',
                ],
                [
                  '02',
                  'Создай аккаунт',
                  'Зарегистрируйся и оплати тариф. Предметы появятся в личном кабинете.',
                ],
                [
                  '03',
                  'Учись в своём темпе',
                  'Смотри уроки, выполняй задания и обсуждай непонятное с учителем.',
                ],
              ].map(([n, title, text]) => (
                <article>
                  <>
                    <span>{n}</span>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </>
                </article>
              ))
            }
          </div><div class="orientation">
            <span class="orientation-icon"
              ><svg><use href="#l-book"></use></svg></span
            ><div>
              <h3>Первый раз на платформе? Всё покажем.</h3><p>
                Раздел «Как учиться в Юнискул» поможет ученику и родителю
                разобраться с уроками, заданиями и личным кабинетом. Входит в
                каждый тариф.
              </p>
            </div><span class="orientation-check">✓</span>
          </div>
        </div>
      </section>
      <section class="faq-section page-width">
        <div>
          <span class="eyebrow">ЕЩЁ НЕМНОГО О ГЛАВНОМ</span><h2>
            Есть вопросы?
          </h2><p>Здесь — ответы перед началом обучения.</p>
        </div><div class="faq-list">
          {
            faqs.map(([q, a]) => (
              <details>
                <>
                  <summary>{q}</summary>
                  <p>{a}</p>
                </>
              </details>
            ))
          }
        </div>
      </section>
      <section class="closing page-width">
        <div>
          <span class="eyebrow">НАЧНИ С ОДНОГО ПОНЯТНОГО УРОКА</span><h2>
            Знания, которые остаются с тобой.
          </h2>
        </div><a class="button blue" href="#plans"
          >Выбрать тариф <svg><use href="#l-arrow"></use></svg></a
        >
      </section>
    </main>
    <footer class="site-footer page-width">
      <a class="brand footer-brand" href={import.meta.env.BASE_URL}
        >юнискул<small>ПРОЕКТ ОНЛАЙН-ГИМНАЗИИ</small></a
      ><span>Учись, когда тебе удобно.</span><a
        href="https://www.onlinegz.ru"
        target="_blank"
        rel="noopener noreferrer">Сайт Онлайн-гимназии ↗</a
      ><a
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}learn/`}
        class="demo-link">Войти в учебный кабинет ↗</a
      >
    </footer>
    <dialog
      id="subject-dialog"
      aria-labelledby="subject-title"
      class="subject-dialog"
    >
      <button
        class="close-button"
        data-close="subject-dialog"
        aria-label="Закрыть программу"
        ><svg><use href="#l-close"></use></svg></button
      ><span id="subject-grade" class="eyebrow"></span><h2 id="subject-title">
      </h2><p class="dialog-subtitle">
        Познакомься с темами и форматом обучения
      </p><div id="subject-program"></div><p class="small-note">
        Пример наполнения для макета. Учебные материалы будут добавлены
        преподавателями.
      </p>
    </dialog>
    <dialog
      id="access-dialog"
      aria-labelledby="access-title"
      class="access-dialog"
    >
      <button
        class="close-button"
        data-close="access-dialog"
        aria-label="Закрыть сообщение о доступе"
        ><svg><use href="#l-close"></use></svg></button
      ><span class="access-lock"><svg><use href="#l-lock"></use></svg></span><h2
        id="access-title"
      >
        Твой следующий шаг —<br />выбрать тариф
      </h2><p id="access-description">
        Уроки и задания открываются после регистрации и оплаты предмета.
      </p><button id="access-plans" class="button orange"
        >Посмотреть тарифы <svg><use href="#l-arrow"></use></svg></button
      >
    </dialog>
    <dialog id="auth-dialog" aria-labelledby="auth-title" class="auth-dialog">
      <button
        class="close-button"
        data-close="auth-dialog"
        aria-label="Закрыть окно входа и регистрации"
        ><svg><use href="#l-close"></use></svg></button
      ><div id="auth-content"></div>
    </dialog>
    <script src="../scripts/landing.js"></script>
    <script src="../scripts/account-tools.js"></script>
  </body>
</html>
